# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files and secrets — never commit tokens
.env
.env.*
!.env.example
**/secrets/
mapillary*.token

# local YOLO batch artifacts
scripts/.mapillary_batch_input.json

# temporary uploaded videos for live demo
/tmp/

# generated helmet tickets
/public/detections/tickets/

# CCTV forensic data + evidence
/data/cctv/
/public/cctv/

# helmet-v5 downloaded weights (large)
/models/helmet-v5/
/models/pose/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# model hub cache
/models/.cache
